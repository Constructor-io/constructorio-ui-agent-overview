{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "noEmit": true,
    "allowJs": true,
    "rootDir": ".",
    "outDir": null,
    "baseUrl": ".",
    "paths": {
      "@src/*": ["src/*"],
      "@spec/*": ["spec/*"],
      "@stories/*": ["stories/*"]
    }
  },
  "include": [
    "src/**/*",
    "spec/**/*",
    "stories/**/*",
    ".storybook/**/*",
    "vite.lib.config.ts",
    "vite.standalone.config.ts",
    "vitest.config.ts",
    "vitest.shims.d.ts",
    "eslint.config.mjs"
  ]
}
