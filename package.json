{
  "name": "@constructor-io/constructorio-ui-agent-overview",
  "version": "0.1.0",
  "description": "Constructor.io Agent Overview UI library",
  "author": "Constructor.io Corporation",
  "license": "MIT",
  "homepage": "https://github.com/Constructor-io/constructorio-ui-agent-overview#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Constructor-io/constructorio-ui-agent-overview.git"
  },
  "bugs": {
    "url": "https://github.com/Constructor-io/constructorio-ui-agent-overview/issues"
  },
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/types/index.d.ts"
    },
    "./style.css": "./dist/styles.css",
    "./constructorio-ui-agent-overview-standalone": {
      "import": "./dist/standalone/constructorio-ui-agent-overview.standalone.js",
      "require": "./dist/standalone/constructorio-ui-agent-overview.standalone.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "dist/styles.css"
  ],
  "engines": {
    "node": ">=14"
  },
  "scripts": {
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:standalone": "vite build --config vite.standalone.config.ts",
    "build:types": "tsc --emitDeclarationOnly",
    "build": "npm run build:lib && npm run build:standalone && npm run build:types",
    "prepublishOnly": "npm run build && npm run check-license",
    "lint": "eslint src spec --no-error-on-unmatched-pattern",
    "lint:fix": "eslint src spec --fix",
    "check-types": "tsc -p tsconfig.eslint.json --noEmit",
    "test": "vitest",
    "test:unit": "vitest --project unit",
    "test:storybook": "vitest --project storybook",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "check-license": "license-checker --production --onlyAllow 'Apache-2.0;BSD-3-Clause;MIT;0BSD;BSD-2-Clause' --excludePackages 'picocolors@1.0.0'",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "vitest --project storybook",
    "test-storybook:watch": "vitest --project storybook --watch",
    "test-storybook:ci": "start-server-and-test storybook:ci http://localhost:6006 test-storybook",
    "storybook-docs-dev": "storybook dev --docs -p 6007"
  },
  "peerDependencies": {
    "@constructor-io/constructorio-client-javascript": "^2.75.0",
    "react": ">=16.12.0",
    "react-dom": ">=16.12.0"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.1",
    "@chromatic-com/storybook": "^5.0.1",
    "@cspell/eslint-plugin": "^9.6.4",
    "@storybook/addon-a11y": "^10.2.10",
    "@storybook/addon-docs": "^10.2.10",
    "@storybook/addon-onboarding": "^10.2.10",
    "@storybook/addon-vitest": "^10.2.10",
    "@storybook/react-vite": "^10.2.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-snapshot-testing": "^1.0.61",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-storybook": "^10.2.10",
    "eslint-plugin-testing-library": "^7.16.0",
    "eslint-plugin-vitest": "^0.5.4",
    "fishery": "^2.4.0",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "license-checker": "^25.0.1",
    "lint-staged": "^16.2.7",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "start-server-and-test": "^2.1.3",
    "storybook": "^10.2.10",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.3.1",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vitest": "^4.0.18",
    "vitest-fail-on-console": "^0.10.1"
  }
}
